  "flows": [
    {
      "id": "hero-cta",
      "name": "\"Explore solutions\" opens Solutions",
      "steps": [
        {
          "action": "tap",
          "target": "home.hero.cta"
        },
        {
          "action": "expectExists",
          "target": "browse.search"
        }
      ]
    },
    {
      "id": "open-detail",
      "name": "Open \"Data Annotation\"",
      "steps": [
        {
          "action": "tap",
          "target": "tab.browse"
        },
        {
          "action": "tap",
          "target": "browse.row.0"
        },
        {
          "action": "expectLabel",
          "target": "detail.header",
          "value": "Data Annotation"
        }
      ]
    },
    {
      "id": "select-option",
      "name": "Choose \"Images\"",
      "steps": [
        {
          "action": "tap",
          "target": "tab.browse"
        },
        {
          "action": "tap",
          "target": "browse.row.0"
        },
        {
          "action": "tap",
          "target": "detail.option.1"
        },
        {
          "action": "expectValue",
          "target": "detail.option.1",
          "value": "selected"
        },
        {
          "action": "expectValue",
          "target": "detail.option.0",
          "value": "unselected"
        }
      ]
    },
    {
      "id": "primary-action",
      "name": "\"Save interest\" confirms",
      "steps": [
        {
          "action": "tap",
          "target": "tab.browse"
        },
        {
          "action": "tap",
          "target": "browse.row.0"
        },
        {
          "action": "tap",
          "target": "detail.primary"
        },
        {
          "action": "expectLabel",
          "target": "detail.confirmation",
          "value": "Interest saved"
        }
      ]
    },
    {
      "id": "search-filter",
      "name": "Search \"Synodex\" filters the list",
      "steps": [
        {
          "action": "tap",
          "target": "tab.browse"
        },
        {
          "action": "type",
          "target": "browse.search",
          "text": "Synodex"
        },
        {
          "action": "expectExists",
          "target": "browse.row.2"
        },
        {
          "action": "expectMissing",
          "target": "browse.row.0"
        }
      ]
    },
    {
      "id": "toggle",
      "name": "Turn on \"Solution updates\"",
      "steps": [
        {
          "action": "tap",
          "target": "tab.account"
        },
        {
          "action": "tap",
          "target": "account.toggle"
        },
        {
          "action": "expectValue",
          "target": "account.toggle",
          "value": "on"
        }
      ]
    },
    {
      "id": "tab-nav",
      "name": "Tab bar navigation",
      "steps": [
        {
          "action": "tap",
          "target": "tab.account"
        },
        {
          "action": "expectExists",
          "target": "account.profile"
        },
        {
          "action": "tap",
          "target": "tab.home"
        },
        {
          "action": "expectExists",
          "target": "home.hero"
        }
      ]
    }
  ]
}