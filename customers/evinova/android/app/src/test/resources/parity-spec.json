  "flows": [
    {
      "id": "hero-cta",
      "name": "\"Start diary\" opens Activities",
      "steps": [
        {
          "action": "tap",
          "target": "home.hero.cta"
        },
        {
          "action": "expectExists",
          "target": "browse.search"
        }
      ]
    },
    {
      "id": "open-detail",
      "name": "Open \"Daily symptom diary\"",
      "steps": [
        {
          "action": "tap",
          "target": "tab.browse"
        },
        {
          "action": "tap",
          "target": "browse.row.0"
        },
        {
          "action": "expectLabel",
          "target": "detail.header",
          "value": "Daily symptom diary"
        }
      ]
    },
    {
      "id": "select-option",
      "name": "Choose \"Same\"",
      "steps": [
        {
          "action": "tap",
          "target": "tab.browse"
        },
        {
          "action": "tap",
          "target": "browse.row.0"
        },
        {
          "action": "tap",
          "target": "detail.option.1"
        },
        {
          "action": "expectValue",
          "target": "detail.option.1",
          "value": "selected"
        },
        {
          "action": "expectValue",
          "target": "detail.option.0",
          "value": "unselected"
        }
      ]
    },
    {
      "id": "primary-action",
      "name": "\"Submit entry\" confirms",
      "steps": [
        {
          "action": "tap",
          "target": "tab.browse"
        },
        {
          "action": "tap",
          "target": "browse.row.0"
        },
        {
          "action": "tap",
          "target": "detail.primary"
        },
        {
          "action": "expectLabel",
          "target": "detail.confirmation",
          "value": "Entry sent to your site team"
        }
      ]
    },
    {
      "id": "search-filter",
      "name": "Search \"Wearable\" filters the list",
      "steps": [
        {
          "action": "tap",
          "target": "tab.browse"
        },
        {
          "action": "type",
          "target": "browse.search",
          "text": "Wearable"
        },
        {
          "action": "expectExists",
          "target": "browse.row.2"
        },
        {
          "action": "expectMissing",
          "target": "browse.row.0"
        }
      ]
    },
    {
      "id": "toggle",
      "name": "Turn on \"Medication reminders\"",
      "steps": [
        {
          "action": "tap",
          "target": "tab.account"
        },
        {
          "action": "tap",
          "target": "account.toggle"
        },
        {
          "action": "expectValue",
          "target": "account.toggle",
          "value": "on"
        }
      ]
    },
    {
      "id": "tab-nav",
      "name": "Tab bar navigation",
      "steps": [
        {
          "action": "tap",
          "target": "tab.account"
        },
        {
          "action": "expectExists",
          "target": "account.profile"
        },
        {
          "action": "tap",
          "target": "tab.home"
        },
        {
          "action": "expectExists",
          "target": "home.hero"
        }
      ]
    }
  ]
}